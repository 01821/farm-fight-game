[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://Scripts/Mine/mine_level.gd" id="1_lvl"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_player.tscn" id="2_player"]
[ext_resource type="Texture2D" path="res://Assets/kenney_pixel-platformer/tilemap_packed.png" id="3_tiles"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_enemy.tscn" id="4_enemy"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_hud.tscn" id="5_hud"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_pickup.tscn" id="6_pickup"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_chest.tscn" id="7_chest"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_boss.tscn" id="8_boss"]

; ⚠️ 两个必须对齐的东西，错一个都不会报错、只会手感不对：
;    1) TileSet.tile_size **必须**和 texture_region_size 一样是 18×18。
;       只设 texture_region_size 的话，显示是对的，但格子在世界里按 16×16 摆，位置全歪。
;    2) 瓦片的物理多边形是**相对格子中心**的，不是左上角！
;       整格 = (-9,-9) 到 (9,9)；单向平台的薄片 = 顶部 6px。
[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_mine"]
texture = ExtResource("3_tiles")
texture_region_size = Vector2i(18, 18)
0:0/0 = 0
0:2/0 = 0
4:0/0 = 0
12:0/0 = 0
0:0/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, 9, -9, 9)
0:2/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, 9, -9, 9)
4:0/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, 9, -9, 9)
12:0/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, -3, -9, -3)
12:0/0/physics_layer_0/polygon_0/one_way = true

[sub_resource type="TileSet" id="TileSet_mine"]
tile_size = Vector2i(18, 18)
physics_layer_0/collision_layer = 1
sources/0 = SubResource("TileSetAtlasSource_mine")

[node name="MineLevel" type="Node2D"]
script = ExtResource("1_lvl")
pickup_scene = ExtResource("6_pickup")

[node name="Terrain" type="TileMapLayer" parent="."]
tile_set = SubResource("TileSet_mine")

; 敌人是**预建实例**，不是运行时 new 出来的。kind 换一种就是换一种怪。
[node name="EnemyA" parent="." instance=ExtResource("4_enemy")]
position = Vector2(250, 198)
kind = 0
patrol_dir = -1

[node name="EnemyB" parent="." instance=ExtResource("4_enemy")]
position = Vector2(400, 198)
kind = 1

[node name="EnemyBat" parent="." instance=ExtResource("4_enemy")]
position = Vector2(330, 130)
kind = 3
patrol_dir = -1

; 尖刺球：沉重的带刺铁球，**打它推不动、也僵不住** —— 只能打死或者躲开。
; 地面顶面 y=198，它的碰撞盒 18x18 居中，所以放在 189。
[node name="EnemySpike" parent="." instance=ExtResource("4_enemy")]
position = Vector2(560, 189)
kind = 4
patrol_dir = -1

; 宝箱也是**预建实例**。地面顶面 y=198，箱子的碰撞盒 18x18 居中，所以放在 189。
[node name="Chest1" parent="." instance=ExtResource("7_chest")]
position = Vector2(150, 189)

; 第二个放在 r9 那层平台上（平台顶面 y=162）
[node name="Chest2" parent="." instance=ExtResource("7_chest")]
position = Vector2(252, 153)
ore_count = 2

; 关底 Boss。放在矿洞最右边（地图 48 格宽 = 864px），地面顶面 y=198。
; 平时待机不动，玩家走进 170px 才会醒 —— 给玩家一个"我走到深处了"的时刻。
[node name="Boss" parent="." instance=ExtResource("8_boss")]
position = Vector2(790, 198)

[node name="MinePlayer" parent="." instance=ExtResource("2_player")]
position = Vector2(40, 40)

