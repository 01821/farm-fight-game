[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_boss.tscn" id="8_boss"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/mine_cart.tscn" id="9_cart"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/descend_point.tscn" id="10_desc"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/spike_trap.tscn" id="11_spike"]
[ext_resource type="PackedScene" path="res://Scenes/Mine/falling_rock.tscn" id="12_rock"]

; ⚠️ 两个必须对齐的东西，错一个都不会报错、只会手感不对：
;    1) TileSet.tile_size **必须**和 texture_region_size 一样是 18×18。
;       只设 texture_region_size 的话，显示是对的，但格子在世界里按 16×16 摆，位置全歪。
;    2) 瓦片的物理多边形是**相对格子中心**的，不是左上角！
;       整格 = (-9,-9) 到 (9,9)；单向平台的薄片 = 顶部 6px。
[sub_resource type="TileSetAtlasSource" id="TileSetAtlasSource_mine"]
texture = ExtResource("3_tiles")
texture_region_size = Vector2i(18, 18)
0:0/0 = 0
0:2/0 = 0
4:0/0 = 0
12:0/0 = 0
0:0/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, 9, -9, 9)
0:2/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, 9, -9, 9)
4:0/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, 9, -9, 9)
12:0/0/physics_layer_0/polygon_0/points = PackedVector2Array(-9, -9, 9, -9, 9, -3, -9, -3)
12:0/0/physics_layer_0/polygon_0/one_way = true

[sub_resource type="TileSet" id="TileSet_mine"]
tile_size = Vector2i(18, 18)
physics_layer_0/collision_layer = 1
sources/0 = SubResource("TileSetAtlasSource_mine")

[node name="MineLevel" type="Node2D"]
script = ExtResource("1_lvl")
pickup_scene = ExtResource("6_pickup")

; --- 背景 ---
; 底色：一块纯色垫在最底下，parallax 层之间露缝也不会穿帮。
; 放在 layer = -20 的 CanvasLayer 里 → 它是**屏幕空间**的，永远盖满视口。
[node name="Backdrop" type="CanvasLayer" parent="."]
layer = -20

[node name="Fill" type="ColorRect" parent="Backdrop"]
offset_right = 400.0
offset_bottom = 300.0
color = Color(0.07, 0.055, 0.09, 1)

; 视差背景。图集是 192×72，三个主题各占一段 —— 取**中间那段橙棕色**（x 72~144），
; 调暗之后那些"山丘"剪影正好读作远处的岩层。
; 两层不同速度 = 纵深：远层几乎不动，近层跟着走一点。
[node name="Parallax" type="ParallaxBackground" parent="."]
layer = -10

[node name="FarLayer" type="ParallaxLayer" parent="Parallax"]
motion_scale = Vector2(0.1, 0.25)
motion_mirroring = Vector2(72, 0)

[node name="Far" type="Sprite2D" parent="Parallax/FarLayer"]
modulate = Color(0.32, 0.27, 0.36, 1)
position = Vector2(0, 150)
scale = Vector2(1, 4.2)
texture = ExtResource("3_tiles")
region_enabled = true
region_rect = Rect2(72, 0, 72, 72)

[node name="NearLayer" type="ParallaxLayer" parent="Parallax"]
motion_scale = Vector2(0.32, 0.55)
motion_mirroring = Vector2(72, 0)

[node name="Near" type="Sprite2D" parent="Parallax/NearLayer"]
modulate = Color(0.52, 0.42, 0.44, 1)
position = Vector2(0, 168)
scale = Vector2(1, 3.4)
texture = ExtResource("3_tiles")
region_enabled = true
region_rect = Rect2(72, 24, 72, 48)

[node name="Terrain" type="TileMapLayer" parent="."]
tile_set = SubResource("TileSet_mine")

; 敌人是**预建实例**，不是运行时 new 出来的。kind 换一种就是换一种怪。
[node name="EnemyA" parent="." instance=ExtResource("4_enemy")]
position = Vector2(250, 198)
kind = 0
patrol_dir = -1

[node name="EnemyB" parent="." instance=ExtResource("4_enemy")]
position = Vector2(400, 198)
kind = 1

[node name="EnemyBat" parent="." instance=ExtResource("4_enemy")]
position = Vector2(330, 130)
kind = 3
patrol_dir = -1

; 尖刺球：沉重的带刺铁球，**打它推不动、也僵不住** —— 只能打死或者躲开。
; 地面顶面 y=198，它的碰撞盒 18x18 居中，所以放在 189。
[node name="EnemySpike" parent="." instance=ExtResource("4_enemy")]
position = Vector2(560, 189)
kind = 4
patrol_dir = -1

; 宝箱也是**预建实例**。地面顶面 y=198，箱子的碰撞盒 18x18 居中，所以放在 189。
[node name="Chest1" parent="." instance=ExtResource("7_chest")]
position = Vector2(150, 189)

; 第二个放在 r9 那层平台上（平台顶面 y=162）
[node name="Chest2" parent="." instance=ExtResource("7_chest")]
position = Vector2(252, 153)
ore_count = 2

; 关底 Boss。放在矿洞最右边（地图 48 格宽 = 864px），地面顶面 y=198。
; 平时待机不动，玩家走进 170px 才会醒 —— 给玩家一个"我走到深处了"的时刻。
[node name="Boss" parent="." instance=ExtResource("8_boss")]
position = Vector2(790, 198)

; 下潜井口，在关底再往右。地图 48 格 = 864px 宽，所以 845 是最右端。
; 必须先拆掉关底才能下去（require_boss）。
[node name="DescendPoint" parent="." instance=ExtResource("10_desc")]
position = Vector2(845, 191)

; 陷阱。地刺摆在地面上（尖朝上，所以放在 y=198），落石挂在高处。
; 位置刻意留了空隙 —— 地刺不是密铺的墙，玩家能跳过去。
[node name="SpikeA" parent="." instance=ExtResource("11_spike")]
position = Vector2(205, 198)

[node name="SpikeB" parent="." instance=ExtResource("11_spike")]
position = Vector2(520, 198)

[node name="RockA" parent="." instance=ExtResource("12_rock")]
position = Vector2(340, 120)

[node name="RockB" parent="." instance=ExtResource("12_rock")]
position = Vector2(640, 120)

; 矿车。碰撞盒 30×14，放在 y=191 时顶面正好是 184（地面顶面 198），
; 也就是"坐"在地面上，玩家走上去只高 14px，一步就能踩上。
; travel=220 → 在 x 360~580 之间来回。
[node name="Cart" parent="." instance=ExtResource("9_cart")]
position = Vector2(470, 191)
travel = 220.0

[node name="MinePlayer" parent="." instance=ExtResource("2_player")]
position = Vector2(40, 40)

[node name="MineHud" parent="." instance=ExtResource("5_hud")]
