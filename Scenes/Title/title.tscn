[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/UI/title.gd" id="1_title"]
[ext_resource type="Texture2D" path="res://Assets/kenney_pixel-platformer/tilemap-backgrounds_packed.png" id="2_bg"]

; ⚠️ TextureRect **没有 region_rect**（那是 Sprite2D 的）。
;    直接给它整张图集的话，三个主题（白天/沙漠/森林）会并排拉满屏，
;    看起来是八条竖色带。只取其中一段要用 AtlasTexture。
[sub_resource type="AtlasTexture" id="AtlasTexture_titlebg"]
atlas = ExtResource("2_bg")
region = Rect2(0, 0, 72, 72)

; 标题界面。
; ⚠️ 三个存档槽是**真正的 Button 节点**，不是 Label —— 鼠标能点、有悬停反馈。
;    键盘（1/2/3）也照旧能用，两条路并存。
[node name="Title" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_title")

; 背景：用背景图集左边那一段（浅蓝天 + 云 + 树 + 远山），
; 整张拉满屏。之前这里是纯黑的，一眼就不像个游戏。
[node name="Backdrop" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
texture = SubResource("AtlasTexture_titlebg")
expand_mode = 1
; stretch_mode：0 = SCALE（拉满），1 = TILE（平铺）。
; 之前写成 1，于是 72px 高的背景在 300px 高的屏幕里**平铺了四次**，
; 看起来是四条一模一样的山丘横带。
stretch_mode = 0

; 压一层暗色，让白字读得清
[node name="Shade" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.06, 0.1, 0.55)

